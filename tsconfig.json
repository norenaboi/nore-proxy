{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    /*
     * The frontend's own aliases, repeated here so the Node test runner can
     * resolve them: tests import frontend modules by relative path, which makes
     * this the tsconfig tsx consults, and a frontend module that value-imports
     * a shared contract would otherwise fail to resolve at run time even though
     * both tsc projects and the Vite build accept it. frontend/tsconfig.json
     * overrides `paths` wholesale, so its own resolution is unaffected.
     */
    "paths": {
      "$frontend/*": ["./frontend/src/*"],
      "$contracts/*": ["./shared/contracts/*"]
    }
  },
  "include": [
    "server.ts",
    "config/**/*.ts",
    "middleware/**/*.ts",
    "routes/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "shared/contracts/**/*.ts",
    "frontend/server/**/*.ts"
  ],
  "exclude": ["node_modules", ".claude"]
}
