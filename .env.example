# Server
PORT=8741
NODE_ENV=production

# Masterkey used for admin authentication (recommended 32 chars)
# MASTER_KEY=SET_A_SECURE_MASTER_KEY

# Admin login rate limiting (attempts per minute per IP)
ADMIN_MAX_ATTEMPTS=5

# Session lifetime in hours
SESSION_TTL_HOURS=24

# CORS origin restriction (leave empty or remove to allow all origins)
CORS_ORIGIN=*

# Optional external PostgreSQL connection. Only postgres:// and postgresql://
# are accepted. Leave unset or blank to use the SQLite files below.
# DATABASE_URL=postgresql://nore_proxy:change-me@db.example.com:5432/nore_proxy

# Runtime JSON paths. Compose overrides these to /app/data/*.
ENDPOINTS_PATH=./endpoints.json
MODELS_PATH=./models.json
SETTINGS_PATH=./settings.json

# SQLite file paths (ignored when PostgreSQL is selected)
LOG_DB_PATH=./logs/logs.db
API_KEY_DB_PATH=./logs/api_keys.db
KEY_STATE_DB_PATH=./logs/key_states.db
SESSION_DB_PATH=./logs/sessions.db
UPTIME_DB_PATH=./logs/uptime.db

# Optional salt for the non-secret API-key identity used in analytics. Defaults
# to MASTER_KEY. Changing it re-derives every stored key identity, which splits
# existing per-key usage history.
# ANALYTICS_SECRET=
