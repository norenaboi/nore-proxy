{
  "name": "nore-proxy-node",
  "version": "1.0.0",
  "description": "API Proxy Server",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "npm run build:frontend",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:frontend",
    "typecheck:server": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit --project frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "test": "node tests/health-check.js",
    "test:frontend": "node --import tsx --test tests/frontend-utilities.test.js",
    "check": "npm test"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "tsx": "^4.23.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.62.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.15.5",
    "cross-env": "^7.0.3",
    "svelte": "^5.56.8",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
